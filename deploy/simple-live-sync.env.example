# Copy to /etc/simple-live-sync/simple-live-sync.env, keep mode 0600, and
# keep the secret private; it preserves anonymous visitor continuity.
PUBLIC_ORIGIN=https://sync.furry.mo.cn
METRICS_ENABLED=true
METRICS_DB_PATH=/var/lib/simple-live-sync/metrics.sqlite
GEOIP_DB_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb
IP_HASH_SECRET=replace-with-at-least-32-random-characters
