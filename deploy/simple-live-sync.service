[Unit]
Description=Simple Live Sync Node service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/simple-live-sync
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=PUBLIC_ORIGIN=https://sync.furry.mo.cn
Environment=METRICS_ENABLED=false
Environment=METRICS_DB_PATH=/var/lib/simple-live-sync/metrics.sqlite
Environment=GEOIP_DB_PATH=/var/lib/GeoIP/GeoLite2-City.mmdb
EnvironmentFile=-/etc/simple-live-sync/simple-live-sync.env
ExecStart=/usr/bin/node /opt/simple-live-sync/dist/server.js
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=simple-live-sync
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/simple-live-sync
ReadOnlyPaths=/var/lib/GeoIP
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
